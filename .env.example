# ─────────────────────────────────────────────────────────────
# Lumen — environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets.
# ─────────────────────────────────────────────────────────────

# --- Application ---------------------------------------------------------------
# Public base URL of the app. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Deployment environment identifier: development | preview | production
APP_ENV=development

# --- Supabase (database + pgvector) -----------------------------------------
# Project URL and anon key are PUBLIC (used by the browser client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is SERVER-ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider abstraction -------------------------------------------------
# LLM is still unused this phase.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (RAG) — SERVER-ONLY ----------------------------------------
# Only "openai" (OpenAI /embeddings or any compatible gateway) is implemented.
# EMBEDDING_API_KEY is a secret; never put it in a NEXT_PUBLIC_ variable.
# EMBEDDING_DIMENSIONS MUST match the document_chunks.embedding vector(N) size
# fixed by migration 20260903000100 (1536). Changing it needs a new migration.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536

# --- RAG ingestion tuning (optional; chunk sizes are in characters) --------
RAG_MAX_PDF_BYTES=15000000
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MIN_CHUNK_SIZE=120

# --- Voice / TTS / Avatar provider abstraction -----------------------------
SPEECH_TO_TEXT_PROVIDER=
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_PROVIDER=
TEXT_TO_SPEECH_API_KEY=
AVATAR_PROVIDER=
AVATAR_API_KEY=

# --- Integration tests (optional) ------------------------------------------
# Needed to run `npm run test:integration` against a live stack.
# Get the URL/key from `npx supabase status` (local) or the dashboard.
# RAG integration tests additionally need LUMEN_TEST_EMBEDDING_API_KEY.
LUMEN_TEST_SUPABASE_URL=
LUMEN_TEST_SERVICE_ROLE_KEY=
LUMEN_TEST_EMBEDDING_API_KEY=
